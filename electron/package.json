{
  "name": "pdf-local",
  "productName": "PDF Local",
  "version": "1.1.0",
  "description": "Herramientas PDF 100% locales",
  "author": "Julio Cedeno",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:py": "cd .. && pyinstaller backend.spec --distpath electron/build --workpath electron/build/tmp --noconfirm",
    "build:vendor": "powershell -NoProfile -ExecutionPolicy Bypass -File prune-vendor.ps1",
    "dist": "npm run build:py && npm run build:vendor && electron-builder --win portable zip",
    "dist:mac": "npm run build:py && electron-builder --mac dmg zip",
    "dist:linux": "npm run build:py && electron-builder --linux AppImage tar.gz"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "rcedit": "4.0.1"
  },
  "build": {
    "appId": "com.julioda18.pdflocal",
    "directories": {
      "buildResources": "resources"
    },
    "files": [
      "main.js",
      "package.json",
      "resources/icon.png"
    ],
    "extraResources": [
      {
        "from": "build/backend",
        "to": "backend"
      }
    ],
    "asar": true,
    "afterPack": "./after-pack.js",
    "artifactName": "PDF-Local-${version}-${os}-${arch}.${ext}",
    "mac": {
      "icon": "resources/icon.png",
      "category": "public.app-category.productivity",
      "identity": null
    },
    "linux": {
      "icon": "resources/icon.png",
      "category": "Office"
    },
    "win": {
      "extraResources": [
        {
          "from": "build/vendor",
          "to": "vendor"
        }
      ],
      "icon": "resources/icon.ico",
      "signAndEditExecutable": false,
      "artifactName": "PDF-Local-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "PDF-Local-${version}-portable.exe"
    }
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  }
}
